# Optional environment overrides (export before start, or edit start-now-playing.sh)
NP_PORT=8787
NP_API_BASE=http://127.0.0.1:81
NP_SHARE_ROOT=/recalbox/share
NP_ES_STATE=/tmp/es_state.inf
NP_RA_CREDS=/recalbox/share/now-playing/ra.local.txt
NP_SYSTEM_LOGO_ROOT=/recalbox/share_init/system/.emulationstation/themes/recalbox-next/data/arts/systems_logos

