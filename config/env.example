# Optional environment overrides (export before start, or edit start-now-playing.sh)
NP_PORT=8787
NP_API_BASE=http://127.0.0.1:81
NP_SHARE_ROOT=/recalbox/share
NP_ES_STATE=/tmp/es_state.inf
NP_RA_CREDS=/recalbox/share/now-playing/ra.local.txt
NP_SYSTEM_LOGO_ROOT=/recalbox/share_init/system/.emulationstation/themes/recalbox-next/data/arts/systems_logos
# UI language: es | en | fr (overrides recalbox.conf system.language)
# NP_LANG=en
# NP_RECALBOX_CONF=/recalbox/share/system/recalbox.conf
# Name in the MiniRA QR code (default: system hostname; ".local" is appended)
# NP_HOSTNAME=recalbox

# Optional tablet wake (ADB not included in this repo)
# NP_TABLET=192.168.x.x:5555
# NP_MARQUEE_URL=http://RECALBOX_IP:8787/minira?fs=1
